<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>.NET wrapper on libpg_query to access PostgreSQL parser outside of the server environment</Description>
    <VersionPrefix>2.0.0</VersionPrefix>
    <Authors>Babu Annamalai</Authors>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <PackageProjectUrl>https://github.com/mysticmind/pgsqlparser-dotnet</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>postgres;pg;pgsql;postgresql;postgres-parser;libpg_query;sql-parser;parser;query-parser</PackageTags>
    <AssemblyName>pgsqlparser</AssemblyName>
    <RootNamespace>PgSqlParser</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.33.0" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <!-- Default to the SDK's own RID if user hasn't specified one -->
    <TargetRID Condition="'$(RuntimeIdentifier)'==''">$(NETCoreSdkRuntimeIdentifier)</TargetRID>
    <LibPgQueryDllName>libpg_query</LibPgQueryDllName>
    <!-- Detect OS -->
    <OSName Condition=" '$(OS)' == 'Windows_NT' ">win</OSName>
    <OSName Condition=" '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true' ">osx</OSName>
    <!-- Alpine and other musl-based Linux need their own native lib; the SDK there reports a linux-musl RID -->
    <OSName Condition=" '$(OSName)' == '' And $(NETCoreSdkRuntimeIdentifier.StartsWith('linux-musl')) ">linux-musl</OSName>
    <OSName Condition=" '$(OSName)' == '' ">linux</OSName>
    <!-- Detect Architecture -->
    <ArchName>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</ArchName>
    <!-- Computed Platform RID -->
    <PlatformRID>$(OSName)-$([System.String]::Copy('$(ArchName)').ToLowerInvariant())</PlatformRID>
  </PropertyGroup>

  <!-- Copy only native libs based on computed PlatformRID for dev-->
  <ItemGroup Condition=" '$(PlatformRID)' == 'linux-x64' ">
    <None Include="Native\linux-x64\$(LibPgQueryDllName).so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>libpg_query.so</TargetPath>
    </None>
  </ItemGroup>
  <ItemGroup Condition=" '$(PlatformRID)' == 'linux-arm64' ">
    <None Include="Native\linux-arm64\$(LibPgQueryDllName).so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>libpg_query.so</TargetPath>
    </None>
  </ItemGroup>
  <ItemGroup Condition=" '$(PlatformRID)' == 'linux-musl-x64' ">
    <None Include="Native\linux-musl-x64\$(LibPgQueryDllName).so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>libpg_query.so</TargetPath>
    </None>
  </ItemGroup>
  <ItemGroup Condition=" '$(PlatformRID)' == 'linux-musl-arm64' ">
    <None Include="Native\linux-musl-arm64\$(LibPgQueryDllName).so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>libpg_query.so</TargetPath>
    </None>
  </ItemGroup>
  <ItemGroup Condition=" '$(PlatformRID)' == 'win-x64' ">
    <None Include="Native\win-x64\$(LibPgQueryDllName).dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>libpg_query.dll</TargetPath>
    </None>
  </ItemGroup>
  <ItemGroup Condition=" '$(PlatformRID)' == 'osx-arm64' ">
    <None Include="Native\osx-arm64\$(LibPgQueryDllName).dylib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>libpg_query.dylib</TargetPath>
    </None>
  </ItemGroup>
  <ItemGroup Condition=" '$(PlatformRID)' == 'osx-x64' ">
    <None Include="Native\osx-x64\$(LibPgQueryDllName).dylib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>libpg_query.dylib</TargetPath>
    </None>
  </ItemGroup>

  <!-- Include all for NuGet packaging -->
  <ItemGroup>
    <None Include="Native\**\*.*">
      <Pack>true</Pack>
      <PackagePath>runtimes/%(RecursiveDir)native/%(Filename)%(Extension)</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="pg_query.proto" GrpcServices="None">
      <Access>Public</Access>
      <ProtoCompile>True</ProtoCompile>
      <ProtoRoot>.</ProtoRoot>
      <CompileOutputs>True</CompileOutputs>
      <OutputDir>$(BaseIntermediateOutputPath)$(TargetFramework)\</OutputDir>
      <Generator>MSBuild:Compile</Generator>
    </Protobuf>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Native\linux-x64\" />
    <Folder Include="Native\osx-x64\" />
    <Folder Include="Native\win-x64\" />
  </ItemGroup>

</Project>
